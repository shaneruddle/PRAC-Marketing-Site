<!-- Hero -->
<section class="bg-paper pt-32 pb-24 border-b border-gray-100">
    <div class="container mx-auto px-6">
        <div class="mb-4 inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-primary rounded-full text-[10px] font-black uppercase tracking-widest border border-blue-100">
            パタヤ レンタカー
        </div>
        <h1 class="text-4xl md:text-6xl font-light tracking-tight mb-6 text-ink">パタヤ <span class="font-black italic text-primary">レンタカー</span></h1>
        <p class="text-xl text-gray-500 max-w-2xl font-medium">パタヤのレンタカーサービス — ホテルやコンドミニアムまで直接お届けします。1日฿590から、隠れた費用は一切なし、フル保険付きです。</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/#booking" class="btn-primary inline-flex">今すぐ予約する</a>
            <a href="https://wa.me/<%= site.contact.whatsapp %>" class="inline-flex items-center justify-center gap-3 bg-white border-2 border-gray-200 hover:border-primary text-ink font-black uppercase tracking-widest py-4 px-8 rounded-full transition-all active:scale-95">WhatsAppで問い合わせ</a>
        </div>
    </div>
</section>

<!-- Main Content -->
<section class="py-24">
    <div class="container mx-auto px-6">
        <div class="max-w-3xl mx-auto space-y-20">

            <!-- 選ばれる理由 -->
            <div>
                <h2 class="text-3xl font-black text-ink mb-6">選ばれる理由</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div class="flex gap-4 items-start">
                        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        </div>
                        <div>
                            <p class="font-black text-ink text-sm mb-1">ホテル配送サービス</p>
                            <p class="text-gray-500 text-sm leading-relaxed">パタヤ全域のホテル・コンドミニアムへ無料で配送いたします。</p>
                        </div>
                    </div>
                    <div class="flex gap-4 items-start">
                        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <div>
                            <p class="font-black text-ink text-sm mb-1">無料キャンセル</p>
                            <p class="text-gray-500 text-sm leading-relaxed">ご予約の変更・キャンセルが必要な際はいつでもご連絡ください。</p>
                        </div>
                    </div>
                    <div class="flex gap-4 items-start">
                        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        </div>
                        <div>
                            <p class="font-black text-ink text-sm mb-1">明瞭な料金設定</p>
                            <p class="text-gray-500 text-sm leading-relaxed">追加料金や隠れた費用は一切なく、料金は明確に表示されています。</p>
                        </div>
                    </div>
                    <div class="flex gap-4 items-start">
                        <div class="w-10 h-10 bg-blue-50 text-primary rounded-full flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        </div>
                        <div>
                            <p class="font-black text-ink text-sm mb-1">フル保険付き</p>
                            <p class="text-gray-500 text-sm leading-relaxed">タイの大手保険会社Viriyah Insuranceの一種保険が全車両に標準付帯しています。</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 車種と料金 -->
            <div>
                <h2 class="text-3xl font-black text-ink mb-6">車種と料金</h2>
                <p class="text-gray-500 leading-relaxed mb-6">
                    エコノミーカーから広々としたSUV、ピックアップトラックまで100台以上の車両をご用意しております。すべての車両はエアコン完備で定期的に点検されています。Honda PCX 150、Honda Clickなどのバイクレンタルもございます。
                </p>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm border-collapse">
                        <thead>
                            <tr class="bg-gray-100">
                                <th class="text-left p-3 font-black text-ink border-b border-gray-200">車種カテゴリー</th>
                                <th class="text-left p-3 font-black text-ink border-b border-gray-200">代表的な車両</th>
                                <th class="text-left p-3 font-black text-ink border-b border-gray-200">1日料金 (THB)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-b border-gray-100">
                                <td class="p-3 text-gray-600 font-medium">エコノミー</td>
                                <td class="p-3 text-gray-600">Honda Jazz, Toyota Yaris</td>
                                <td class="p-3 text-gray-600">฿590から</td>
                            </tr>
                            <tr class="border-b border-gray-100">
                                <td class="p-3 text-gray-600 font-medium">セダン</td>
                                <td class="p-3 text-gray-600">Toyota Vios, Honda City</td>
                                <td class="p-3 text-gray-600">฿790から</td>
                            </tr>
                            <tr class="border-b border-gray-100">
                                <td class="p-3 text-gray-600 font-medium">SUV</td>
                                <td class="p-3 text-gray-600">Honda HR-V, Toyota Fortuner</td>
                                <td class="p-3 text-gray-600">฿1,200から</td>
                            </tr>
                            <tr>
                                <td class="p-3 text-gray-600 font-medium">ピックアップトラック</td>
                                <td class="p-3 text-gray-600">Toyota Revo, MG Extender</td>
                                <td class="p-3 text-gray-600">฿1,500から</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="text-xs text-gray-400 mt-3 leading-relaxed">
                    上記料金は最低3日間レンタルの場合の1日料金です。シーズンにより料金が変動する場合がございます。正確な料金はWhatsAppにてお問い合わせください。
                </p>
            </div>

            <!-- 必要書類 -->
            <div>
                <h2 class="text-3xl font-black text-ink mb-6">必要書類</h2>
                <ul class="space-y-3 mb-4">
                    <li class="flex gap-3 items-start">

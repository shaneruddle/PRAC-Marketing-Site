                <h3 class="card-title"><%= lang === 'ru' ? 'Поддержка 24/7' : (lang === 'ko' ? '24시간 지원' : (lang === 'zh' ? '24小时支持' : (lang === 'de' ? '24/7 Support' : (lang === 'ja' ? '24時間サポート' : (lang === 'fr' ? 'Assistance 24/7' : '24/7 Support'))))) %></h3>

<section class="bg-paper pt-32 pb-24 border-b border-gray-100">
    <div class="container mx-auto px-6">
        <div class="mb-4 inline-flex items-center gap-2 px-3 py-1 bg-blue-50 text-primary rounded-full text-[10px] font-black uppercase tracking-widest border border-blue-100">
            <%= (t.fleet && t.fleet.badge) || 'Pattaya Fleet' %>
        </div>
        <h1 class="text-4xl md:text-6xl font-light tracking-tight mb-6 text-ink"><%= (t.fleet && t.fleet.heading) || 'Our' %> <span class="font-black italic text-primary"><%= (t.fleet && t.fleet.headingAccent) || 'Fleet' %></span></h1>
        <p class="text-xl text-gray-500 max-w-2xl font-medium">
        <% if (lang === 'th') { %>
            รถทุกคันได้รับการดูแลตามมาตรฐานสูงสุด พร้อมประกันภัยและบริการช่วยเหลือฉุกเฉินรวมอยู่ในทุกการเช่า ดู<a href="<%= langPrefix %>/cheap-car-rental-pattaya/" class="text-primary font-semibold hover:underline">รถเช่าราคาประหยัดในพัทยา</a>สำหรับรถราคาถูกที่สุดและอัตราค่าเช่ารายวัน
        <% } else if (lang === 'ru') { %>
            Качественные автомобили, обслуживаемые по высочайшим стандартам. Страхование и помощь на дороге включены в каждую аренду. Полный список моделей, цены и условия — на странице <a href="<%= langPrefix %>/arenda-avto-pattaya/" class="text-primary font-semibold hover:underline">аренда авто в Паттайе</a>.
        <% } else if (lang === 'ko') { %>
            모든 차량은 최고 기준으로 관리되며, 보험과 긴급 도로 지원이 모든 렌트에 포함됩니다. <a href="<%= langPrefix %>/car-rental-pattaya-korean/" class="text-primary font-semibold hover:underline">파타야 렌터카 전체 안내</a>에서 차량 종류, 가격, 예약 방법을 확인하세요.
        <% } else if (lang === 'zh') { %>
            所有车辆均按最高标准维护。每笔租车订单均含保险及道路救援服务。查看我们的<a href="<%= langPrefix %>/cars/" class="text-primary font-semibold hover:underline">全部车型</a>，了解详细车款与每日价格。
        <% } else if (lang === 'de') { %>
            Qualitativ hochwertige Fahrzeuge nach hoechsten Standards gewartet. Versicherung und Pannenhilfe sind in jeder Miete enthalten. Alle Details zu Modellen und Tagespreisen finden Sie unter <a href="<%= langPrefix %>/autovermietung-pattaya/" class="text-primary font-semibold hover:underline">Autovermietung Pattaya</a>.
        <% } else if (lang === 'ja') { %>
            すべての車両は最高水準で整備されています。保険とロードサービスはすべてのレンタルに含まれます。<a href="<%= langPrefix %>/car-rental-pattaya-japanese/" class="text-primary font-semibold hover:underline">パタヤ レンタカー完全ガイド</a>で車種、料金、ご予約方法をご確認いただけます。
        <% } else if (lang === 'fr') { %>
            Des vehicules de qualite entretenus selon les normes les plus elevees. Assurance et assistance routiere incluses dans chaque location. Consultez notre page <a href="<%= langPrefix %>/location-voiture-pattaya/" class="text-primary font-semibold hover:underline">Location de Voiture Pattaya</a> pour tous les details sur les modeles et tarifs journaliers.
        <% } else { %>
            Quality vehicles maintained to the highest standards. Insurance and road assistance included in every rental. View our <a href="/cheap-car-rental-pattaya/" class="text-primary font-semibold hover:underline">cheap car rental Pattaya</a> page for our lowest-priced vehicles and daily rate breakdown.
        <% } %>
        </p>
    </div>
</section>

<section class="py-24">
    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            <% guides.forEach(guide => { %>
                <div class="bg-white rounded-3xl overflow-hidden shadow-2xl shadow-primary/5 border border-gray-100 group flex flex-col transition-all hover:shadow-primary/10 hover:-translate-y-1">
                    <div class="aspect-[4/3] bg-paper relative overflow-hidden">
                        <% if (guide.heroImage) { %>
                            <img src="<%= guide.heroImage %>" alt="<%= guide.title %>" class="absolute inset-0 w-full h-full object-cover">
                        <% } else { %>
                            <div class="absolute inset-0 flex items-center justify-center text-gray-300 font-black uppercase tracking-widest text-[10px]"><%= (t.fleet && t.fleet.noImage) || 'No Image' %></div>
                        <% } %>
                        <div class="absolute top-4 left-4">
                            <span class="bg-white/90 backdrop-blur px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest text-ink shadow-sm border border-gray-100"><%= guide.category %></span>
                        </div>
                    </div>
                    <div class="p-8 flex-1 flex flex-col">
                        <div class="flex justify-between items-start mb-4">
                            <div>
                                <h3 class="text-2xl font-black text-ink group-hover:text-primary transition-colors"><%= guide.title %></h3>
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] text-gray-400 font-black uppercase tracking-[0.1em] mt-2">
                                    <span><%= guide.transmission %></span>
                                    <span class="w-1 h-1 bg-gray-200 rounded-full"></span>
                                    <span><%= guide.seats %> <%= (t.fleet && t.fleet.seatsLabel) || 'Seats' %></span>
                                    <span class="w-1 h-1 bg-gray-200 rounded-full"></span>
                                    <span><%= guide.fuelType %></span>
                                </div>
                            </div>
                        </div>
                        <p class="text-sm text-gray-500 mb-10 line-clamp-2 leading-relaxed font-medium">
                            <%= guide.intro %>
                        </p>
                        <div class="mt-auto flex flex-col gap-3">
                            <a href="<%= langPrefix %>/cars/<%= guide.slug %>" class="btn-primary w-full text-xs py-3 group">
                                <%= (t.fleet && t.fleet.selectVehicle) || 'Select Vehicle' %>
                                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                            <a href="<%= langPrefix %>/cars/<%= guide.slug %>" class="text-center py-3 rounded-2xl border border-gray-100 text-[10px] font-black uppercase tracking-widest text-ink/40 hover:text-primary hover:border-primary transition-all"><%= (t.fleet && t.fleet.viewSpecs) || 'View Specifications' %></a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>


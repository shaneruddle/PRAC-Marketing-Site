        <%= lang === 'ru' ? 'Смотреть доступные автомобили' : (lang === 'ko' ? '이용 가능한 차량 검색' : (lang === 'zh' ? '搜索可用车辆' : (lang === 'de' ? 'Verfuegbare Autos suchen' : (lang === 'ja' ? '利用可能な車両を検索' : (lang === 'fr' ? 'Rechercher un Vehicule' : 'Search Available Cars'))))) %>

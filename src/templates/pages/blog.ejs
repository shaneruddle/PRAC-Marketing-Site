<section class="bg-gray-100 pt-32 pb-24">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-black tracking-tighter leading-[0.9] mb-4">Blog</h1>
        <p class="text-xl text-gray-500">Tips, guides, and news for renting in Pattaya.</p>
        <div class="max-w-xl mx-auto mt-8">
        	<div class="relative">
        		<input type="text" id="blog-search-input" placeholder="Search articles..." autocomplete="off" class="w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 text-sm text-ink focus:outline-none focus:border-primary transition-colors bg-white">
        		<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" /></svg>
        	</div>
        </div>
    </div>
</section>

<section class="py-24">
    <div class="container mx-auto px-4">
        <% if (posts && posts.length > 0) { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-post-grid">
            <% posts.forEach(post => { %>
            <a href="<%= langPrefix %>/blog/<%= post.slug %>/" class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 flex flex-col hover:-translate-y-1 transition-all">
                <div class="aspect-[16/9] bg-gray-200 overflow-hidden">
                    <% if (post.coverImage) { %>
                    <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform" loading="lazy" />
                    <% } %>
                </div>
                <div class="p-6 flex flex-col flex-1">
                    <% if (post.category) { %>
                    <span class="text-[10px] font-black uppercase tracking-widest text-primary mb-2"><%= post.category %></span>
                    <% } %>
                    <h2 class="text-lg font-bold text-ink mb-2 group-hover:text-primary transition-colors leading-snug"><%= post.title %></h2>
                    <p class="text-gray-500 text-sm leading-relaxed mb-4 flex-1"><%= post.excerpt %></p>
                    <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">
                        <%= new Date(post.publishedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </span>
                </div>
            </a>
            <% }) %>
        </div>
        <p id="blog-search-empty" class="hidden text-center text-gray-500 py-12">No articles found. Try a different search.</p>

        <% if (totalPages > 1) { %>
        <nav class="flex items-center justify-center gap-2 mt-16" id="blog-pagination">
            <% const prevHref = currentPage === 2 ? (langPrefix + '/blog/') : (langPrefix + '/blog/page/' + (currentPage - 1) + '/'); %>
            <% if (currentPage > 1) { %>
            <a href="<%= prevHref %>" class="px-4 py-2 rounded-xl border border-gray-100 text-xs font-black uppercase tracking-widest hover:border-gray-300 transition-colors">Prev</a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
                <% const href = i === 1 ? (langPrefix + '/blog/') : (langPrefix + '/blog/page/' + i + '/'); %>
                <% if (i === currentPage) { %>
                <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary text-white text-sm font-black"><%= i %></span>
                <% } else { %>
                <a href="<%= href %>" class="w-10 h-10 flex items-center justify-center rounded-xl border border-gray-100 text-sm font-bold hover:border-gray-300 transition-colors"><%= i %></a>
                <% } %>
            <% } %>
            <% if (currentPage < totalPages) { %>
            <a href="<%= langPrefix %>/blog/page/<%= currentPage + 1 %>/" class="px-4 py-2 rounded-xl border border-gray-100 text-xs font-black uppercase tracking-widest hover:border-gray-300 transition-colors">Next</a>
            <% } %>
        </nav>
        <% } %>

        <% } else { %>
        <p class="text-center text-gray-500">No blog posts yet. Check back soon.</p>
        <% } %>
    </div>
</section>

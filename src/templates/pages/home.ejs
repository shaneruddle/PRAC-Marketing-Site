const _defWhy=[{title:'Free Cancellation',desc:'Up to 24 hours before your pickup, no questions asked.'},{title:'24/7 Support',desc:'Real humans ready to help you on WhatsApp and Line anytime.'},{title:'Full Insurance',desc:'Every rental includes comprehensive insurance for your peace of mind.'},{title:'Hotel Delivery',desc:'We bring the car to you. No need to visit our office.'}];

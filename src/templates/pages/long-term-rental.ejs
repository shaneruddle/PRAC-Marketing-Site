        <div class="rounded-[50px] overflow-hidden shadow-2xl shadow-black/10 aspect-[4/3]"><img src="https://firebasestorage.googleapis.com/v0/b/pattaya-rent-a-car-rebuild.firebasestorage.app/o/vehicle-guides%2Feconomy-car-rental%2Fhero_1780122822793_2.png?alt=media&token=1b581775-fe40-4008-9026-0623933ad3ba" alt="Long term car rental Pattaya" class="w-full h-full object-cover" loading="eager" /></div>
      </div>
    </div>
  </div>
</section>

<section class="bg-paper py-20">

      ] : lang === 'ko' ? [
        { title: '오래 머물수록 더 좋은 가격', body: '장기 이용에 대한 우대 월 요금 &mdash; 렌트 기간이 길수록 더 좋은 조건을 받으실 수 있습니다.' },
        { title: '완전 보험 포함', body: '모든 장기 렌트에는 Viriyah 완전 보험이 포함됩니다 &mdash; 추가 비용이나 예상치 못한 부담이 없습니다.' },
        { title: '무료 배달 및 회수', body: '파타야 어디든 콘도, 빌라, 호텔까지 차량을 배달해 드리고 &mdash; 이용 종료 시 회수해 드립니다.' },
        { title: '정비 및 유지보수 완비', body: '오일 교환, 타이어 교체 등 모든 정기 정비를 렌트 기간 내내 저희가 책임집니다.' },
        { title: '유연한 차량 교체', body: '다른 차량이 필요하시거나 연장을 원하시나요? 7일 전에만 알려주시면 조정해 드립니다.' },
        { title: '24시간 지원', body: '전화, WhatsApp, Line을 통한 24시간 지원 &mdash; 언제든 필요할 때 도와드립니다.' }
      ] : lang === 'zh' ? [
        { title: '租期越长，价格越优惠', body: '专属月租优惠价格，回报长期客户 &mdash; 租期越长，价格越划算。' },
        { title: '包含全险保障', body: '每笔长期租赁均包含 Viriyah 全险保障 &mdash; 无附加费用，无意外惊喜。' },
        { title: '免费送车与取车', body: '我们会将车辆送至芭提雅任何地点的公寓、别墅或酒店 &mdash; 租期结束后也会上门取车。' },
        { title: '维修保养全包', body: '换机油、轮胎更换及所有定期保养，整个租期内均由我们负责处理。' },
        { title: '灵活更换车辆', body: '需要更换车型或想延长租期？提前7天通知我们，我们会为您安排。' },
        { title: '24小时支持', body: '通过电话、WhatsApp和Line提供全天候支持 &mdash; 随时为您服务。' }
      ] : lang === 'de' ? [
        { title: 'Bessere Konditionen je laenger Sie bleiben', body: 'Guenstige Monatstarife, die sich lohnen &mdash; je laenger Ihre Miete, desto besser der Preis.' },
        { title: 'Erstklassige Versicherung inklusive', body: 'Jede Langzeitmiete umfasst eine vollstaendige Viriyah-Versicherung &mdash; keine Zusatzkosten, keine Ueberraschungen.' },
        { title: 'Kostenlose Lieferung & Abholung', body: 'Wir liefern zu Ihrem Kondo, Ihrer Villa oder Ihrem Hotel in ganz Pattaya &mdash; und holen das Fahrzeug am Ende ab.' },
        { title: 'Wartung & Service inklusive', body: 'Oelwechsel, Reifenwechsel und alle geplanten Wartungsarbeiten uebernehmen wir waehrend Ihrer gesamten Mietzeit.' },
        { title: 'Flexibler Fahrzeugwechsel', body: 'Brauchen Sie ein anderes Fahrzeug oder moechten verlaengern? Geben Sie uns einfach 7 Tage Vorlauf.' },
        { title: '24/7 Support', body: 'Rund-um-die-Uhr-Hilfe per Telefon, WhatsApp und Line &mdash; wann immer Sie uns brauchen.' }
      ] : lang === 'ja' ? [
        { title: '長く滞在するほどお得に', body: '長期利用に応える優遇月額料金 &mdash; レンタル期間が長いほど、より良い条件をご提供します。' },
        { title: 'フル保険付き', body: 'すべての長期レンタルにViriyahの完全保険が付帯 &mdash; 追加料金もサプライズもありません。' },
        { title: '無料配送・回収', body: 'パタヤ内のどこへでもコンド、ヴィラ、ホテルまでお届けし &mdash; ご利用終了時には回収にお伺いします。' },
        { title: 'メンテナンス込み', body: 'オイル交換、タイヤ交換、すべての定期メンテナンスをレンタル期間中ずっと対応いたします。' },
        { title: '柔軟な車両変更', body: '別の車両が必要な場合や延長をご希望の場合も、7日前にご連絡いただければ調整いたします。' },
        { title: '24時間サポート', body: '電話、WhatsApp、Lineによる24時間対応 &mdash; いつでもご連絡ください。' }
      ] : lang === 'fr' ? [
        { title: 'Meilleur Tarif Plus Vous Restez', body: 'Des tarifs mensuels preferentiels qui recompensent la fidelite &mdash; plus votre location est longue, meilleur est le tarif.' },
        { title: 'Assurance Complete Incluse', body: 'Chaque location longue duree comprend une assurance Viriyah complete &mdash; sans supplement, sans surprise.' },
        { title: 'Livraison & Recuperation Gratuites', body: 'Nous livrons a votre condo, villa ou hotel partout a Pattaya &mdash; et recuperons le vehicule a la fin de votre sejour.' },
        { title: 'Entretien & Maintenance Pris en Charge', body: "Vidanges, rotation des pneus et tout l'entretien programme sont pris en charge pendant toute la duree de votre location." },
        { title: 'Changement de Vehicule Flexible', body: "Besoin d'un autre vehicule ou envie de prolonger ? Previenez-nous simplement 7 jours a l'avance." },
        { title: 'Assistance 24/7', body: 'Aide 24h/24 par telephone, WhatsApp et Line &mdash; quand vous en avez besoin.' }
      ] : [
        { title: 'Better Value the Longer You Stay', body: 'Preferential monthly rates that reward commitment &mdash; the longer your rental, the better your deal.' },
        { title: 'First-Class Insurance Included', body: 'Every long-term rental comes with full Viriyah insurance coverage &mdash; no extras, no surprises.' },
        { title: 'Free Delivery & Collection', body: 'We deliver to your condo, villa, or hotel anywhere in Pattaya &mdash; and collect at the end of your stay.' },
        { title: 'Servicing & Maintenance Handled', body: 'Oil changes, tyre rotation, and all scheduled servicing taken care of throughout your rental.' },
        { title: 'Flexible Vehicle Swaps', body: "Need a different vehicle or want to extend? Just give us 7 days' notice and we'll arrange it." },
        { title: '24/7 Support', body: 'Round-the-clock assistance via phone, WhatsApp, and Line &mdash; whenever you need us.' }
      ]; %>
      <% ltFeatures.forEach(f => { %>
      <div class="flex gap-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 mt-1"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
        <div>
          <h3 class="font-bold text-lg tracking-tight text-ink mb-1"><%= f.title %></h3>
          <p class="card-body"><%- f.body %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Availability & vehicles section -->
<section class="bg-paper py-20">
  <div class="max-w-7xl mx-auto px-6">
    <span class="eyebrow"><%= (t.longTerm && t.longTerm.pricingEyebrow) || 'Availability' %></span>
    <h2 class="text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-4 max-w-3xl"><%= (t.longTerm && t.longTerm.pricingH2) || 'Vehicles Currently Available for Long-Term Rent' %></h2>
    <p class="text-ink/60 text-lg mb-12 max-w-2xl"><%= (t.longTerm && t.longTerm.pricingIntro) || 'Availability changes as vehicles come free from short-term bookings, so here\'s what we currently have. All long-term rentals include insurance, delivery, and servicing.' %></p>

    <% const ltUi = lang === 'ru' ? {
        perMonth: 'мес.', minMonths: 'мин. срок', enquire: 'Узнать больше',
        noListings: 'Сейчас нет свободных автомобилей для долгосрочной аренды — свяжитесь с нами, и мы сообщим, как только появится подходящий вариант.'
      } : lang === 'ko' ? {
        perMonth: '개월', minMonths: '최소 기간', enquire: '문의하기',
        noListings: '현재 장기 렌트 가능한 차량이 없습니다 — 문의해 주시면 가능해지는 대로 알려드리겠습니다.'
      } : lang === 'zh' ? {
        perMonth: '月', minMonths: '最短租期', enquire: '立即咨询',
        noListings: '目前没有可供长期租赁的车辆 — 请联系我们，一旦有车可用我们会立即通知您。'
      } : lang === 'de' ? {
        perMonth: 'Monat', minMonths: 'Mindestdauer', enquire: 'Anfragen',
        noListings: 'Aktuell ist kein Fahrzeug fuer eine Langzeitmiete verfuegbar — kontaktieren Sie uns, wir informieren Sie, sobald eines frei wird.'
      } : lang === 'ja' ? {
        perMonth: 'ヶ月', minMonths: '最低期間', enquire: 'お問い合わせ',
        noListings: '現在、長期レンタル可能な車両はございません — お問い合わせいただければ、空き次第ご連絡いたします。'
      } : lang === 'fr' ? {
        perMonth: 'Mois', minMonths: 'Duree min.', enquire: 'Nous contacter',
        noListings: "Aucun vehicule n'est actuellement disponible a la location longue duree — contactez-nous et nous vous previendrons des qu'un vehicule se libere."
      } : {
        perMonth: 'month', minMonths: 'min.', enquire: 'Enquire',
        noListings: "Nothing is currently available for long-term rent — contact us and we'll let you know as soon as a vehicle opens up."
      };
    %>

    <% if (listings && listings.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <% listings.forEach(function(listing) { %>
      <div class="glass-card rounded-[32px] p-8">
        <% if (listing.image) { %>
        <div class="rounded-2xl overflow-hidden aspect-[4/3] mb-5"><img src="<%= listing.image %>" alt="<%= listing.carName %>" class="w-full h-full object-cover" loading="lazy" /></div>
        <% } %>
        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink/40 mb-3"><%= listing.carType %></div>
        <div class="text-3xl font-black tracking-tighter text-ink mb-1">฿<%= listing.monthlyPrice.toLocaleString() %><span class="text-lg font-medium text-ink/40">/<%= ltUi.perMonth %></span></div>
        <p class="card-body font-semibold text-ink/80"><%= listing.carName %><% if (listing.minMonths > 1) { %> &middot; <%= ltUi.minMonths %> <%= listing.minMonths %><% } %></p>
        <% if (listing.notes) { %><p class="card-body mt-1"><%= listing.notes %></p><% } %>
        <a href="#enquire" class="link-arrow mt-4 inline-flex"><%= ltUi.enquire %></a>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="glass-card rounded-[32px] p-10 mb-16 max-w-2xl">
      <p class="card-body text-lg"><%= ltUi.noListings %></p>
      <a href="#enquire" class="btn-primary inline-flex mt-6"><%= ltUi.enquire %></a>
    </div>
    <% } %>
  </div>
</section>

<section id="enquire" class="bg-paper pb-32">
  <div class="max-w-7xl mx-auto px-6">
    <div class="dark-block">
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary/20 blur-[120px] rounded-full pointer-events-none"></div>
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-6"><%= (t.longTerm && t.longTerm.quoteH2) || 'Get a Custom Quote' %></h2>
          <p class="text-white/60 text-lg leading-relaxed"><%= (t.longTerm && t.longTerm.quoteIntro) || "Tell us how long you need a vehicle and we'll send our best long-term rate within a few hours. You can also reach us directly by phone or WhatsApp we speak English and Thai." %></p>
        </div>
        <form id="lt-form" class="space-y-5">
          <!-- Honeypot field &mdash; hidden from humans, bots fill it -->
          <input
            type="text"
            id="lt-honeypot"
            name="website"
            autocomplete="off"
            tabindex="-1"
            aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none;"
          />
          <div>
            <label class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 font-bold block mb-2"><%= lang === 'ru' ? 'Имя' : (lang === 'ko' ? '이름' : (lang === 'zh' ? '姓名' : (lang === 'de' ? 'Name' : (lang === 'ja' ? 'お名前' : (lang === 'fr' ? 'Nom' : 'Name'))))) %></label>
            <input type="text" id="lt-name" name="Name" required class="w-full bg-white/10 border-none rounded-2xl p-4 outline-none focus:bg-white/20 transition-all font-medium text-white placeholder-white/30">
          </div>
          <div>
            <label class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 font-bold block mb-2">Email</label>
            <input type="email" id="lt-email" name="Email" required class="w-full bg-white/10 border-none rounded-2xl p-4 outline-none focus:bg-white/20 transition-all font-medium text-white placeholder-white/30">
          </div>
          <div>
            <label class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 font-bold block mb-2"><%= lang === 'ru' ? 'Телефон / WhatsApp' : (lang === 'ko' ? '전화 / WhatsApp' : (lang === 'zh' ? '电话 / WhatsApp' : (lang === 'de' ? 'Telefon / WhatsApp' : (lang === 'ja' ? '電話番号 / WhatsApp' : (lang === 'fr' ? 'Telephone / WhatsApp' : 'Phone / WhatsApp'))))) %></label>
            <input type="tel" id="lt-phone" name="Phone" placeholder="+66 81 234 5678" class="w-full bg-white/10 border-none rounded-2xl p-4 outline-none focus:bg-white/20 transition-all font-medium text-white placeholder-white/30">
          </div>
          <div>
            <label class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/40 font-bold block mb-2"><%= lang === 'ru' ? 'На какой срок вам нужен автомобиль?' : (lang === 'ko' ? '얼마 동안 차량이 필요하신가요?' : (lang === 'zh' ? '您需要租车多长时间？' : (lang === 'de' ? 'Wie lange benoetigen Sie ein Fahrzeug?' : (lang === 'ja' ? 'どのくらいの期間車両が必要ですか？' : (lang === 'fr' ? 'De combien de temps avez-vous besoin du vehicule ?' : 'How long do you need a vehicle?'))))) %></label>
            <textarea id="lt-details" name="Details" rows="4" required class="w-full bg-white/10 border-none rounded-2xl p-4 outline-none focus:bg-white/20 transition-all font-medium text-white placeholder-white/30 resize-none"></textarea>
          </div>
          <div id="lt-result" data-theme="dark" class="hidden"></div>
          <button type="submit" id="lt-submit" class="btn-primary w-full justify-center"><%= lang === 'ru' ? 'Отправить запрос' : (lang === 'ko' ? '요청 보내기' : (lang === 'zh' ? '发送请求' : (lang === 'de' ? 'Anfrage senden' : (lang === 'ja' ? 'リクエストを送信' : (lang === 'fr' ? 'Envoyer la Demande' : 'Send Request'))))) %></button>
        </form>
      </div>
    </div>
  </div>
</section>

<section class="bg-paper py-20">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-4xl md:text-5xl font-bold tracking-tighter text-ink mb-12 text-right"><%= (t.longTerm && t.longTerm.faqH2) || 'Common Questions' %></h2>
    <div class="space-y-4 max-w-3xl ml-auto">
      <% const ltFaqs = lang === 'ru' ? [
        { q: 'Сколько стоит долгосрочная аренда автомобиля в Паттайе?', a: 'Долгосрочная аренда в Паттайе начинается от 20 000 бат в месяц за пикапы (Toyota Hilux Revo, Isuzu D-Max) и от 30 000 бат в месяц за внедорожники (Toyota Fortuner, Ford Everest). Все тарифы включают полное страхование, бесплатную доставку и плановое обслуживание. Аренда от 3 месяцев даёт право на индивидуальные тарифы.' },
        { q: 'Что включено в месячную аренду?', a: 'Каждая долгосрочная аренда включает полное страхование от Viriyah, бесплатную доставку и возврат в любой точке Паттайи, а также всё плановое обслуживание (замена масла, шин и т.д.). Никаких скрытых доплат.' },
        { q: 'Могу ли я арендовать на 3 месяца и дольше?', a: 'Да, и мы это активно приветствуем. Аренда от 3 месяцев и дольше даёт право на значительно более выгодные тарифы. Свяжитесь с нами, указав даты и предпочитаемый автомобиль, и мы подготовим индивидуальный расчёт.' },
        { q: 'Может ли автомобилем управлять кто-то ещё?', a: 'Да. В договор аренды можно добавить дополнительных водителей. Пожалуйста, сообщите нам об этом при бронировании, чтобы мы могли всё оформить.' },
        { q: 'Нужны ли мне тайские водительские права?', a: 'Нет. Принимаются международное водительское удостоверение (IDP) или действующие права из вашей страны. Если вы планируете остаться надолго, мы рекомендуем со временем оформить тайские права, но это не является обязательным условием для аренды у нас.' }
      ] : lang === 'ko' ? [
        { q: '파타야 장기 렌터카 비용은 얼마인가요?', a: '파타야 장기 렌트는 픽업트럭(Toyota Hilux Revo, Isuzu D-Max) 기준 월 20,000밧부터, SUV(Toyota Fortuner, Ford Everest) 기준 월 30,000밧부터 시작합니다. 모든 요금에는 완전 보험, 무료 배달, 정기 정비가 포함됩니다. 3개월 이상 렌트 시 협의된 요금이 적용됩니다.' },
        { q: '월 렌트에는 무엇이 포함되나요?', a: '모든 장기 렌트에는 Viriyah 완전 보험, 파타야 전 지역 무료 배달 및 회수, 그리고 모든 정기 정비(오일 교환, 타이어 교체 등)가 포함됩니다. 숨겨진 추가 비용은 없습니다.' },
        { q: '3개월 이상 렌트할 수 있나요?', a: '네, 오히려 적극 권장해 드립니다. 3개월 이상 렌트 시 훨씬 더 좋은 요금이 적용됩니다. 원하시는 날짜와 차종을 알려주시면 맞춤 견적을 준비해 드립니다.' },
        { q: '다른 사람이 운전해도 되나요?', a: '네. 추가 운전자를 렌트 계약에 등록하실 수 있습니다. 문의 시 미리 알려주시면 적절히 준비해 드리겠습니다.' },
        { q: '태국 운전면허증이 필요한가요?', a: '아니요. 국제운전면허증(IDP) 또는 본국의 유효한 운전면허증이면 충분합니다. 장기 체류를 계획 중이시라면 나중에 태국 면허증을 취득하시는 것을 권장드리지만, 저희와의 렌트 조건은 아닙니다.' }
      ] : lang === 'zh' ? [
        { q: '芭提雅长期租车费用是多少？', a: '芭提雅长期租车皮卡（Toyota Hilux Revo、Isuzu D-Max）月租起价20,000泰铢，SUV（Toyota Fortuner、Ford Everest）月租起价30,000泰铢。所有价格均含全险、免费送车及定期保养。租期满3个月以上可享受协商价格。' },
        { q: '月租车费用包含哪些内容？', a: '每笔长期租车均含 Viriyah 全险保障、芭提雅全境免费送车及取车服务，以及所有定期保养（换机油、轮胎更换等）。没有任何隐藏附加费用。' },
        { q: '可以租3个月以上吗？', a: '当然可以，我们非常鼓励长租。租期满3个月或以上可享受更优惠的价格。请告知我们您的用车时间及车型偏好，我们会为您准备专属报价。' },
        { q: '可以让其他人驾驶吗？', a: '可以。可在租赁协议中添加额外驾驶员。请在咨询时告知我们，以便做出相应安排。' },
        { q: '需要泰国驾驶证吗？', a: '不需要。持有国际驾驶执照（IDP）或本国有效驾驶证即可。如果您计划长期居留，我们建议您日后办理泰国驾照，但这并非在我们这里租车的必要条件。' }
      ] : lang === 'de' ? [
        { q: 'Was kostet eine Langzeitmiete in Pattaya?', a: 'Langzeitmiete in Pattaya beginnt bei 20.000 Baht/Monat fuer Pickups (Toyota Hilux Revo, Isuzu D-Max) und ab 30.000 Baht/Monat fuer SUVs (Toyota Fortuner, Ford Everest). Alle Tarife beinhalten Vollkasko, kostenlose Lieferung und geplante Wartung. Ab 3 Monaten gelten Sondertarife.' },
        { q: 'Was ist in der Monatsmiete enthalten?', a: 'Jede Langzeitmiete umfasst eine vollstaendige Viriyah-Versicherung, kostenlose Lieferung und Abholung in ganz Pattaya sowie alle geplanten Wartungsarbeiten (Oelwechsel, Reifenwechsel usw.). Es gibt keine versteckten Zusatzkosten.' },
        { q: 'Kann ich fuer 3 Monate oder laenger mieten?', a: 'Ja, und wir empfehlen es sogar. Ab 3 Monaten Mietdauer gelten deutlich bessere Tarife. Teilen Sie uns Ihre Termine und Ihr Wunschfahrzeug mit, und wir erstellen ein individuelles Angebot.' },
        { q: 'Darf jemand anderes das Auto fahren?', a: 'Ja. Zusaetzliche namentlich genannte Fahrer koennen dem Mietvertrag hinzugefuegt werden. Bitte teilen Sie uns dies bei der Anfrage mit, damit wir alles entsprechend vorbereiten koennen.' },
        { q: 'Brauche ich einen thailaendischen Fuehrerschein?', a: 'Nein. Ein internationaler Fuehrerschein (IDP) oder ein gueltiger Fuehrerschein aus Ihrem Heimatland wird akzeptiert. Wenn Sie langfristig bleiben moechten, empfehlen wir irgendwann einen thailaendischen Fuehrerschein zu beantragen, dies ist jedoch keine Voraussetzung fuer die Miete bei uns.' }
      ] : lang === 'ja' ? [
        { q: 'パタヤの長期レンタカー料金はいくらですか？', a: 'パタヤの長期レンタルはピックアップトラック（Toyota Hilux Revo、Isuzu D-Max）で月20,000THBから、SUV（Toyota Fortuner、Ford Everest）で月30,000THBからとなります。すべての料金にはフル保険、無料配送、定期メンテナンスが含まれます。3ヶ月以上のご利用で特別料金が適用されます。' },
        { q: '月極レンタルには何が含まれますか？', a: 'すべての長期レンタルにはViriyahの完全保険、パタヤ全域への無料配送・回収、すべての定期メンテナンス（オイル交換、タイヤ交換など）が含まれます。隠れた追加費用は一切ありません。' },
        { q: '3ヶ月以上のレンタルは可能ですか？', a: 'はい、むしろおすすめしております。3ヶ月以上のレンタルではより有利な料金が適用されます。ご希望の日程とお車の種類をお知らせいただければ、カスタム見積もりをご用意いたします。' },
        { q: '他の人が運転することはできますか？', a: 'はい。追加ドライバーを賃貸契約に登録することができます。お問い合わせの際にお知らせいただければ、適切に手配いたします。' },
        { q: 'タイの運転免許証は必要ですか？', a: 'いいえ。国際運転免許証（IDP）またはご本国の有効な運転免許証で構いません。長期滞在をご予定の場合は将来的にタイの免許証を取得されることをお勧めしますが、当社でのレンタルには必須ではありません。' }
      ] : lang === 'fr' ? [
        { q: 'Combien coute une location longue duree a Pattaya ?', a: "La location longue duree a Pattaya commence a 20 000 baht/mois pour les pickups (Toyota Hilux Revo, Isuzu D-Max) et a partir de 30 000 baht/mois pour les SUV (Toyota Fortuner, Ford Everest). Tous les tarifs incluent l'assurance complete, la livraison gratuite et l'entretien programme. Les locations de 3 mois ou plus beneficient de tarifs negocies." },
        { q: "Qu'est-ce qui est inclus dans une location mensuelle ?", a: "Chaque location longue duree comprend une assurance Viriyah complete, la livraison et la recuperation gratuites partout a Pattaya, ainsi que tout l'entretien programme (vidanges, rotation des pneus, etc.). Il n'y a aucun frais cache." },
        { q: 'Puis-je louer pour 3 mois ou plus ?', a: "Oui, et nous vous y encourageons vivement. Les locations de 3 mois ou plus beneficient de tarifs nettement meilleurs. Indiquez-nous vos dates et le vehicule souhaite, et nous preparerons un devis personnalise." },
        { q: "Quelqu'un d'autre peut-il conduire la voiture ?", a: "Oui. Des conducteurs supplementaires nommes peuvent etre ajoutes au contrat de location. Merci de nous en informer lors de votre demande afin que nous puissions faire le necessaire." },
        { q: "Ai-je besoin d'un permis de conduire thailandais ?", a: "Non. Un permis de conduire international (IDP) ou un permis valide de votre pays d'origine est accepte. Si vous prevoyez de rester longtemps, nous vous recommandons d'obtenir un permis thailandais a terme, mais ce n'est pas une condition pour louer chez nous." }
      ] : [
        { q: 'How much does long-term car rental cost in Pattaya?', a: 'Rates depend on which vehicle is currently available for long-term hire — see current availability and pricing above, or contact us directly for today\'s rates. All rates include full insurance, free delivery, and scheduled servicing.' },
        { q: 'What is included in a monthly rental?', a: 'Every long-term rental includes full Viriyah insurance coverage, free delivery and collection anywhere in Pattaya, and all scheduled servicing (oil changes, tyre rotation, etc.). There are no hidden extras.' },
        { q: 'Can I rent for 3 months or longer?', a: "Yes, subject to availability. Long-term vehicles are limited, especially during high season, so contact us with your dates and preferred vehicle and we'll confirm what's currently available." },
        { q: 'Can someone else drive the car?', a: 'Yes. Additional named drivers can be added to the rental agreement. Please let us know when enquiring so we can make the appropriate arrangements.' },
        { q: 'Do I need a Thai driving licence?', a: "No. An international driving permit (IDP) or a valid driving licence from your home country is accepted. If you plan to stay long-term, we'd recommend obtaining a Thai licence eventually, but it is not a requirement to rent with us." }
      ]; %>
      <% ltFaqs.forEach(item => { %>
      <details class="glass-card rounded-[24px] p-6 group">
        <summary class="flex items-center justify-between cursor-pointer font-bold text-ink text-lg tracking-tight list-none">
          <%= item.q %>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary shrink-0 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <p class="card-body mt-4"><%= item.a %></p>
      </details>
      <% }) %>
    </div>
  </div>
</section>

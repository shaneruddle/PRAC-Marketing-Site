      <% if (lang === 'ru') { %>Ваш чек-лист <em class="italic" style="color:#F07D17">перед поездкой</em><% } else if (lang === 'ko') { %>운전 전 <em class="italic" style="color:#F07D17">체크리스트</em><% } else if (lang === 'zh') { %>您的<em class="italic" style="color:#F07D17">行前检查</em>清单<% } else if (lang === 'de') { %>Ihre Checkliste <em class="italic" style="color:#F07D17">vor der Fahrt</em><% } else if (lang === 'ja') { %>運転前<em class="italic" style="color:#F07D17">チェックリスト</em><% } else if (lang === 'fr') { %>Votre liste de controle <em class="italic" style="color:#F07D17">avant depart</em><% } else { %>Your <em class="italic" style="color:#F07D17">pre-drive</em> checklist<% } %>
    </h1>

    <p style="font-size:19px;color:rgba(29,29,27,.62);max-width:680px">
      <% if (lang === 'ru') { %>Арендуете автомобиль в Паттайе? Уделите девяносто секунд перед отъездом. Эти десять быстрых проверок защитят ваш депозит, упростят страховые вопросы и подарят полное спокойствие на дороге.<% } else if (lang === 'ko') { %>파타야에서 렌터카를 이용하시나요? 출발 전 90초만 투자하세요. 이 10가지 빠른 점검이 보증금을 보호하고 보험 처리를 간편하게 하며 마음 편히 운전하실 수 있게 도와드립니다.<% } else if (lang === 'zh') { %>在芭提雅租车吗？出发前花90秒进行检查。这10项快速检查能保护您的押金，简化保险流程，让您安心上路。<% } else if (lang === 'de') { %>Mieten Sie ein Auto in Pattaya? Nehmen Sie sich neunzig Sekunden Zeit, bevor Sie losfahren. Diese zehn schnellen Kontrollen schuetzen Ihre Kaution, vereinfachen die Versicherung und geben Ihnen absolute Sicherheit auf der Strasse.<% } else if (lang === 'ja') { %>パタヤでレンタカーをご利用ですか？出発前に90秒お時間をください。この10項目の簡単なチェックで、デポジットを守り、保険手続きをシンプルにし、安心してドライブに出発できます。<% } else if (lang === 'fr') { %>Vous louez une voiture a Pattaya ? Prenez quatre-vingt-dix secondes avant de partir. Ces dix verifications rapides protegent votre caution, simplifient votre assurance et vous offrent une tranquillite d'esprit totale sur la route.<% } else { %>Renting a car in Pattaya? Take ninety seconds before you drive away. These ten quick checks protect your deposit, keep your insurance simple, and get you on the road with total peace of mind.<% } %>
    </p>

    <!-- Responsive 16:9 video embed -->
    <div style="position:relative;width:100%;padding-top:56.25%;margin-top:34px;margin-bottom:8px;border-radius:22px;overflow:hidden;box-shadow:0 30px 70px -30px rgba(29,29,27,.35);border:1px solid rgba(29,29,27,.10);background:#0a0a0a">
      <iframe
        src="/video/prac-pre-drive-check.html"
        title="Pattaya Rent a Car — Pre-Drive Checklist"
        loading="lazy"
        allowfullscreen
        style="position:absolute;inset:0;width:100%;height:100%;border:0"
      ></iframe>
    </div>
    <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink/40 mb-12"><%= lang === 'ru' ? '90-секундное руководство · Без регистрации · Работает на мобильных' : (lang === 'ko' ? '90초 가이드 · 가입 불필요 · 모바일 지원' : (lang === 'zh' ? '90秒指南 · 无需注册 · 支持手机浏览' : (lang === 'de' ? '90-Sekunden-Anleitung · Keine Anmeldung · Mobilfreundlich' : (lang === 'ja' ? '90秒ガイド · 登録不要 · スマホ対応' : (lang === 'fr' ? 'Guide de 90 secondes · Sans inscription · Compatible mobile' : '90-second guide · No sign-up · Works on mobile'))))) %></p>

  </div>
</section>

<!-- 10-step written checklist (SEO payload) -->
<section class="bg-paper pb-16">
  <div class="container mx-auto px-4 max-w-3xl">

    <h2 class="text-3xl font-extrabold tracking-tight text-ink mb-6"><%= lang === 'ru' ? 'Проверка из 10 пунктов, шаг за шагом' : (lang === 'ko' ? '10가지 단계별 점검 항목' : (lang === 'zh' ? '10项检查，逐步完成' : (lang === 'de' ? 'Die 10-Punkte-Kontrolle, Schritt fuer Schritt' : (lang === 'ja' ? '10項目のチェック、ステップごとに解説' : (lang === 'fr' ? 'La verification en 10 points, etape par etape' : 'The 10-point check, step by step'))))) %></h2>

    <ol class="space-y-3 list-none m-0 p-0">
      <% steps.forEach(function(step, i) { %>
      <li style="display:flex;gap:18px;background:#fff;border:1px solid rgba(29,29,27,.10);border-radius:16px;padding:18px 22px;list-style:none;align-items:flex-start">
        <div style="font-size:14px;font-weight:800;color:#fff;background:#1D1D1B;min-width:42px;height:42px;border-radius:999px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <%= i < 9 ? '0' + (i + 1) : (i + 1) %>
        </div>
        <div>
          <h3 style="font-weight:800;font-size:18px;letter-spacing:-0.01em;margin:0 0 3px;color:#1D1D1B"><%= step.title %></h3>
          <p style="font-size:15px;color:rgba(29,29,27,.62);margin:0;line-height:1.6"><%- step.body %></p>
        </div>
      </li>
      <% }); %>
    </ol>

  </div>
</section>

<!-- CTA block -->
